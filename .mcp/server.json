{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "local/deep-re-searxng",
  "title": "Deep Re SearXNG",
  "description": "SearXNG MCP server bundled with Codex deep research skills",
  "repository": {
    "url": "https://github.com/LocalT0aster/deep-re-searxng",
    "source": "github"
  },
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "deep-re-searxng",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SEARXNG_URL",
          "description": "URL of your SearXNG instance",
          "isRequired": true,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ]
}
